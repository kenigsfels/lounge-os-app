VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
VITE_SYLON_AGENT_ENABLED=false
# Optional override. By default the enabled agent uses <VITE_SUPABASE_URL>/functions/v1/sylon-agent
# VITE_SYLON_AGENT_URL=https://your-project.supabase.co/functions/v1/sylon-agent

# Server-only Supabase Edge Function secrets (never prefix these with VITE_):
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=nvidia/your-tool-calling-model
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
